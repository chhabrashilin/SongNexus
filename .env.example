# Copy to .env and fill in. Never commit .env.

# --- Backend (all optional for local development) ---
# Defaults to a SQLite file at data/songnexus.db. Production and docker compose use PostgreSQL:
# SONGNEXUS_DATABASE_URL=postgresql+psycopg://songnexus:songnexus@localhost:5432/songnexus
SONGNEXUS_LOG_JSON=false
SONGNEXUS_CORS_ORIGINS=["http://localhost:5173"]

# Enables POST /api/v1/system/reload (rebuild the read model after ingestion). Leave empty to disable.
SONGNEXUS_ADMIN_TOKEN=

# LLM mode for the discovery agent. Leave empty to use the deterministic planner only.
ANTHROPIC_API_KEY=
# SONGNEXUS_AGENT_MODEL=claude-opus-5-5
# SONGNEXUS_AGENT_EFFORT=medium

# MusicBrainz asks API clients to identify themselves with a contact (email or URL).
# Only needed for `songnexus fetch`; the committed snapshot works offline.
SONGNEXUS_MUSICBRAINZ_CONTACT=

# --- docker compose ---
POSTGRES_PASSWORD=songnexus-local-only
# Host ports (change if another project already uses them)
SONGNEXUS_API_PORT=8000
SONGNEXUS_WEB_PORT=8080
