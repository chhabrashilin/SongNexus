# Copy to web/.env.local. Only needed for sign-in; everything else works without it.
# Values come from the Firebase console (Project settings → Your apps → Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
# Use the Hosting domain in production so sign-in works without third-party cookies.
VITE_FIREBASE_AUTH_DOMAIN=
# Local development with the Auth emulator:
# VITE_FIREBASE_AUTH_EMULATOR=http://127.0.0.1:9099

# Where the dev server proxies /v1 (default http://127.0.0.1:8790, from `songnexus serve`).
# SONGNEXUS_API=http://127.0.0.1:8790
