{
  "name": "songnexus-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "test": "vitest run",
    "e2e": "playwright test",
    "api:types": "openapi-typescript ../server/openapi.json -o src/api/schema.d.ts --default-non-nullable false"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "@fontsource-variable/roboto": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "d3-drag": "^3.0.1",
    "d3-force": "^3.0.1",
    "d3-selection": "^3.0.1",
    "d3-zoom": "^3.0.1",
    "fflate": "^0.8.3",
    "firebase": "^13.3.0",
    "intl-messageformat": "^12.1.5",
    "openapi-fetch": "^0.17.0",
    "papaparse": "^5.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "gts": "^7.0.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.6"
    }
  }
}
