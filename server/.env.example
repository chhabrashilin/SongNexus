# Copy to server/.env for local development. Every setting is SONGNEXUS_<NAME> (see src/songnexus/config.py).

# Database. Zero setup: a SQLite file. Production parity: `docker compose up -d` at the repo root, then
# SONGNEXUS_DATABASE_URL=postgresql+psycopg://songnexus:songnexus@127.0.0.1:15432/songnexus
SONGNEXUS_DATABASE_URL=sqlite:///../songnexus-dev.db

SONGNEXUS_ENVIRONMENT=development
SONGNEXUS_LOG_JSON=false
SONGNEXUS_LOG_LEVEL=INFO

# Origins allowed to send writes (CSRF defense). The Vite dev server runs on 5173.
SONGNEXUS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Sign-in. Leave empty to browse without accounts. With the Firebase Auth emulator
# (`npx firebase-tools emulators:start --only auth`), set the project and the emulator host:
SONGNEXUS_FIREBASE_PROJECT_ID=
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# MusicBrainz asks API clients to identify themselves; optional, used only by `songnexus fetch`.
SONGNEXUS_MUSICBRAINZ_CONTACT=

# Linked listening accounts (ADR 0006, docs/linked-accounts.md). In development a token key is
# generated for you and the sync job can run inside the API process. ListenBrainz needs no keys.
SONGNEXUS_SYNC_IN_PROCESS=true
# Open the app at this origin while linking (providers redirect back to it).
SONGNEXUS_APP_ORIGIN=http://127.0.0.1:5173
# Spotify: developer.spotify.com/dashboard -> create an app -> redirect URI
#   http://127.0.0.1:5173/v1/oauth/spotify/callback
SONGNEXUS_SPOTIFY_CLIENT_ID=
# YouTube Music (liked songs): console.cloud.google.com -> enable "YouTube Data API v3" -> OAuth
# client (Web application) -> redirect URI http://127.0.0.1:5173/v1/oauth/youtube_music/callback
SONGNEXUS_GOOGLE_CLIENT_ID=
SONGNEXUS_GOOGLE_CLIENT_SECRET=
# Last.fm: last.fm/api/account/create (callback URL is sent with each request)
SONGNEXUS_LASTFM_API_KEY=
SONGNEXUS_LASTFM_SECRET=
# Libre.fm, Deezer and Apple Music: see docs/linked-accounts.md
